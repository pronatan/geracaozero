option_settings:
  # AL2023 PHP usa nginx por padrão; Apache faz o .htaccess (URLs limpas) funcionar
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: apache
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /
    memory_limit: 256M
    allow_url_fopen: "On"
    display_errors: "Off"
    zlib.output_compression: "Off"
