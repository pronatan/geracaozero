# Enable .htaccess rewrites for clean URLs
files:
  "/etc/httpd/conf.d/gz_allowoverride.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      <Directory "/var/app/current">
        AllowOverride All
        Options FollowSymLinks
        Require all granted
      </Directory>
container_commands:
  01_reload_apache:
    command: "systemctl reload httpd || service httpd reload || true"
    ignoreErrors: true
