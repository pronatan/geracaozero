# Enable .htaccess rewrites for clean URLs (when ProxyServer=apache)
files:
  "/etc/httpd/conf.d/gz_allowoverride.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      <Directory "/var/app/current">
        AllowOverride All
        Options FollowSymLinks
        Require all granted
      </Directory>
container_commands:
  01_chmod_hooks:
    command: "chmod +x /var/app/staging/.platform/hooks/postdeploy/*.sh 2>/dev/null; chmod +x /var/app/current/.platform/hooks/postdeploy/*.sh 2>/dev/null; true"
    ignoreErrors: true
  02_reload_apache:
    command: "systemctl reload httpd || service httpd reload || true"
    ignoreErrors: true
