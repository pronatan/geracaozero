# Copie para .env e preencha (NUNCA commitar o .env)

# Mercado Pago — use chaves de PRODUÇÃO do painel (não TEST-)
# Credenciais → Produção → Access Token + Public Key
MP_ACCESS_TOKEN=APP_USR-sua-access-token-producao
MP_PUBLIC_KEY=APP_USR-sua-public-key-producao
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=https://geracaozero.ddnsfree.com/api/webhook.php
MP_SSL_VERIFY=true

# DynamoDB (opcional — no EB usa a role da instância)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
DDB_USERS_TABLE=gz_users
DDB_ORDERS_TABLE=gz_orders
DDB_PRODUCTS_TABLE=gz_products

# Cupons (DynamoDB) — gerencie no painel Admin → Cupons
DDB_COUPONS_TABLE=gz_coupons
# Fallback opcional se a tabela estiver vazia: CODIGO:percentual
GZ_COUPONS=

# Site / e-mail (Brevo)
SITE_URL=https://geracaozero.ddnsfree.com
BREVO_API_KEY=
# Remetente verificado no Brevo (pode ser Gmail, sem domínio próprio)
MAIL_FROM=Geração Zero <guihcomercial@gmail.com>
# true = forgot.php devolve o link no JSON (só para testes)
GZ_RESET_DEV=false

# Fase B/C — VIP automático (RCON)
# Quando pagamento for aprovado no webhook, o site envia o comando no Minecraft.
MC_VIP_AUTO=false
MC_RCON_HOST=
MC_RCON_PORT=25575
MC_RCON_PASSWORD=
MC_VIP_COMMAND=lp user {nick} parent set {vip}

# Mapa / Discord OAuth + bot (2FA DM)
GZ_MAP_URL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Redirect OAuth: https://geracaozero.ddnsfree.com/api/auth/discord-callback.php
DISCORD_BOT_TOKEN=

# S3 assets (produtos / avatares)
S3_ASSETS_BUCKET=geracaozero-assets-983902695861
S3_ASSETS_BASE_URL=https://geracaozero-assets-983902695861.s3.us-east-1.amazonaws.com

# Dynu DNS
DYNU_API_KEY=
DYNU_OAUTH_CLIENT_ID=
DYNU_OAUTH_SECRET=
DYNU_DOMAIN_PRIMARY=geracaozero.ddnsfree.com
DYNU_DOMAIN_SECONDARY=geracaozero.freeddns.org
