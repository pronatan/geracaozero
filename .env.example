# Copie para .env e preencha (NUNCA commitar o .env)

# Mercado Pago — use chaves de PRODUÇÃO do painel (não TEST-)
# Credenciais → Produção → Access Token + Public Key
MP_ACCESS_TOKEN=APP_USR-sua-access-token-producao
MP_PUBLIC_KEY=APP_USR-sua-public-key-producao
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=https://geracaozero.ddnsfree.com/api/webhook.php
MP_SSL_VERIFY=true

# DynamoDB (opcional — no EB usa a role da instância)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
DDB_USERS_TABLE=gz_users
DDB_ORDERS_TABLE=gz_orders
DDB_PRODUCTS_TABLE=gz_products

# Dynu DNS
DYNU_API_KEY=
DYNU_OAUTH_CLIENT_ID=
DYNU_OAUTH_SECRET=
DYNU_DOMAIN_PRIMARY=geracaozero.ddnsfree.com
DYNU_DOMAIN_SECONDARY=geracaozero.freeddns.org
